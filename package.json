    "repository": {
        "type": "git",
        "url": "git+https://github.com/jwl-7/pacman-cleaner.git"
    },
    "homepage": "https://github.com/jwl-7/pacman-cleaner#readme",
    "bugs": {
        "url": "https://github.com/jwl-7/pacman-cleaner/issues"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "typescript": "^5.0.0"
    }
}
