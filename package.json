{
    "name": "pacman-cleaner",
    "version": "1.0.0",
    "description": "Clear your terminal the fun way!",
    "type": "module",
    "bin": {
        "pacman-cleaner": "dist/index.js",
        "pacclean": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
