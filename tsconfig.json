{
    "compilerOptions": {
        "target"                          : "ESNext",
        "module"                          : "NodeNext",
        "moduleResolution"                : "NodeNext",
        "outDir"                          : "./dist",
        "rootDir"                         : "./src",
        "types"                           : [ "node" ],
        "strict"                          : true,
        "esModuleInterop"                 : true,
        "skipLibCheck"                    : true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [ "src" ]
}
